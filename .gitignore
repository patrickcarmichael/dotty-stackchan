# SBOM artifacts — regenerated by scripts/generate-sbom.sh
sbom.json
sbom-server.json

# pytest-cov artifacts (regenerated each run)
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Frontend build deps for the dashboard's vendored Tailwind bundle.
# package.json + tailwind.config.js are committed; build artifacts and
# the npm install state are not. Re-run `npm install && npm run build:css`
# to regenerate bridge/static/tailwind.min.css.
node_modules/
package-lock.json

# Setup-wizard generated files (issue #11). The tracked `.template`
# counterparts are the source of truth; `make setup` renders these by
# substituting answers from .wizard.env. Edit the templates if you want
# changes that persist across regen; the live files are disposable.
/.config.yaml
/docker-compose.yml
/zeroclaw-bridge.service
/.wizard.env
/.config.yaml.bak.*
/docker-compose.yml.bak.*
/zeroclaw-bridge.service.bak.*

# Runtime / downloaded artifacts
/models/
/tmp/
