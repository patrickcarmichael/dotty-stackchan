__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
*.log
.DS_Store

# Claude Code session artifacts (lock files, local settings)
.claude/

# Secrets / credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
id_*
secrets.*
